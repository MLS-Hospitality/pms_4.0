# PMS 4.0 Environment Configuration
# Copy this file to .env and fill in your local values
# cp .env.example .env

# CodeIgniter Environment: development | testing | production
CI_ENV=development

# Database Settings (used by application/config/database.php)
DB_HOSTNAME=localhost
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
DB_DATABASE=pms4_local

# Optional: Paystack Keys
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
